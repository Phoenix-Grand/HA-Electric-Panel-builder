{
  "name": "home-assistant-panel-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A visual US electrical panel inventory and Home Assistant dashboard card",
  "scripts": {
    "start": "node scripts/serve.mjs",
